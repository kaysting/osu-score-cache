<!DOCTYPE html>
<html lang="en">
    <!-- Gemini created the styling for this site, full disclosure -->

    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title><%= locals.title || '' %></title>
        <meta property="og:site_name" content="<%= locals.meta?.siteName || '' %>" />
        <meta property="og:title" content="<%= locals.meta?.title || '' %>" />
        <meta property="og:description" content="<%= locals.meta?.description || '' %>" />

        <link href="https://kaysting.dev/assets/css/base.css" rel="stylesheet" />
        <link href="https://kaysting.dev/assets/css/utils.css" rel="stylesheet" />

        <style>
            :root {
                --c-base-hue: 240;
                --c-accent-hue: 240;
            }
            .container {
                padding: 24px 16px;
                margin: 0 auto;
                max-width: 900px;
            }
        </style>
    </head>

    <body>
        <article class="container"><%- content %></article>
    </body>
</html>
